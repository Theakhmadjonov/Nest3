generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id    Int     @id @default(autoincrement())
  name  String
  email String  @unique
}

model Product {
  id    Int     @id @default(autoincrement())
  name  String
  price Float
}

model Category {
  id   Int    @id @default(autoincrement())
  name String
}

model Order {
  id        Int    @id @default(autoincrement())
  quantity  Int
  productId Int
}

model Customer {
  id   Int    @id @default(autoincrement())
  name String
  age  Int
}
