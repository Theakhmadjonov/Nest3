generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id      Int    @id @default(autoincrement())
  name    String
  email   String @unique
  role    String
  @@map("users")
}

model Product {
  id       Int    @id @default(autoincrement())
  name     String
  price    Float
  category String
}

model Order {
  id       Int    @id @default(autoincrement())
  userId   Int
  product  String
  status   String
}

model Category {
  id       Int    @id @default(autoincrement())
  name     String
}
